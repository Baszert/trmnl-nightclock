<div class="layout nk-layout">
  <div class="nk nk--quadrant" data-view="quadrant" {{ nk_attrs }}>
    <script type="application/json" class="nk-data">{{ nk_json }}</script>
    <svg class="nk-svg" xmlns="http://www.w3.org/2000/svg"></svg>
    <div class="nk-head">
      <span class="label label--small nk-up nk-w" data-nk="kicker"></span>
      <span class="title lg:title--xlarge nk-w" data-nk="verdict"></span>
      <span class="description nk-w nk-sub" data-nk="sub"></span>
    </div>
    <div class="nk-meta">
      <span class="label label--small nk-w" data-nk="dark"></span>
      <span class="label label--small nk-w" data-nk="moon"></span>
      <span class="label label--small nk-w" data-nk="later"></span>
      <span class="label label--small nk-w" data-nk="shower"></span>
    </div>
  </div>
</div>
