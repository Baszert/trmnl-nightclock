{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- assign nk_ll = cf.lat_lon | default: '' | split: ',' -%}
{%- capture nk_attrs -%}
data-ts="{{ trmnl.system.timestamp_utc }}" data-locale="{{ trmnl.user.locale | default: 'en' }}" data-lang="{{ cf.language | default: 'auto' }}" data-clock="{{ cf.clock | default: 'auto' }}" data-moment="{{ cf.moment | default: 'auto' }}" data-lines="{% if cf.lines == false or cf.lines == 'false' or cf.lines == '0' or cf.lines == 'off' %}off{% else %}on{% endif %}" data-names="{% if cf.names == false or cf.names == 'false' or cf.names == '0' or cf.names == 'off' %}off{% else %}on{% endif %}" data-test="{{ cf.test_date | escape }}" data-place="{{ cf.place_name | escape }}"
