<style>
.nk-layout { padding: 0 !important; background: #000; }
.nk { position: relative; width: 100%; height: 100%; min-height: 0; background: #000; overflow: hidden; }
.nk-svg { position: absolute; inset: 0; display: block; }
.nk-svg, .nk-svg text { font-family: "Inter Variable", Inter, "Helvetica Neue", Arial, sans-serif; }
.nk-head, .nk-meta { position: absolute; display: flex; flex-direction: column; gap: 4px; }
.nk-head { left: 22px; top: 16px; max-width: 52%; align-items: flex-start; }
.nk-meta { right: 22px; top: 18px; align-items: flex-end; text-align: right; max-width: 44%; background: #000; padding: 2px 0 4px 10px; }
.nk .nk-w { color: #fff; }
.nk .nk-up { text-transform: uppercase; letter-spacing: 0.1em; }
.nk .hidden { display: none; }
.nk-svg .nk-t1 { font-family: var(--label-font-family); font-size: var(--label-font-size); font-weight: var(--label-font-weight); -webkit-font-smoothing: var(--label-font-smoothing); }
.nk-svg .nk-t2 { font-family: var(--label-small-font-family); font-size: var(--label-small-font-size); font-weight: var(--label-small-font-weight); -webkit-font-smoothing: var(--label-small-font-smoothing); }
.nk--half_horizontal .nk-head { top: 10px; } .nk--half_horizontal .nk-meta { top: 12px; } .nk--half_horizontal .nk-sub { display: none; }
.nk--half_vertical .nk-head { max-width: 88%; } .nk--half_vertical .nk-meta { display: none; }
.nk--quadrant .nk-head { left: 14px; top: 10px; max-width: 70%; } .nk--quadrant .nk-sub, .nk--quadrant .nk-meta { display: none; }
.screen--portrait .nk--full .nk-meta { left: 22px; right: auto; top: 128px; align-items: flex-start; text-align: left; background: none; padding: 0; }
.screen--lg .nk-head { left: 30px; top: 22px; gap: 8px; } .screen--lg .nk-meta { right: 30px; top: 26px; gap: 8px; }
.screen--lg .nk-svg .nk-t1 { font-family: var(--label-large-font-family); font-size: var(--label-large-font-size); }
.screen--lg .nk-svg .nk-t2 { font-family: var(--label-font-family); font-size: var(--label-font-size); }
[class*="screen--color-"] .nk .nk-p--mars { fill: var(--stroke-red-40-color, #fff); }
[class*="screen--color-"] .nk .nk-p--jupiter, [class*="screen--color-"] .nk .nk-p--saturn, [class*="screen--color-"] .nk .nk-ring { fill: var(--stroke-yellow-60-color, #fff); }
[class*="screen--color-"] .nk .nk-ring { fill: none; stroke: var(--stroke-yellow-60-color, #fff); }
[class*="screen--color-"] .nk .nk-moonlit { fill: var(--stroke-yellow-70-color, #fff); }
</style>
