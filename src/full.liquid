<div class="layout nk-layout">
  <div class="nk nk--full" data-view="full" {{ nk_attrs }}>
    <script type="application/json" class="nk-data">{{ nk_json }}</script>
    <svg class="nk-svg" xmlns="http://www.w3.org/2000/svg"></svg>
    <div class="nk-head">
      <span class="label label--small lg:label--base nk-up nk-w" data-nk="kicker"></span>
      <span class="title title--xlarge lg:title--xxlarge nk-w" data-nk="verdict"></span>
      <span class="description lg:description--large lg:text--regular nk-w nk-sub" data-nk="sub"></span>
    </div>
    <div class="nk-meta">
      <span class="label label--small lg:label--base nk-w" data-nk="dark"></span>
      <span class="label label--small lg:label--base nk-w" data-nk="moon"></span>
      <span class="label label--small lg:label--base nk-w" data-nk="later"></span>
      <span class="label label--small lg:label--base nk-w" data-nk="shower"></span>
    </div>
  </div>
</div>
